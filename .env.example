# Environment Configuration File for Gestionale Abbigliamento Sicuro
# Copy this file to .env and fill in your specific values

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gestionale_abbigliamento
DB_USER=gestionale_user
DB_PASSWORD=your_secure_db_password
DB_ROOT_PASSWORD=your_root_password

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here_minimum_32_characters
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Application Configuration
NODE_ENV=development
APP_PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# WhatsApp Business API Configuration
WHATSAPP_API_KEY=your_whatsapp_business_api_key
WHATSAPP_PHONE_NUMBER=your_whatsapp_business_phone_number
WHATSAPP_API_URL=https://graph.facebook.com/v18.0

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads
PDF_OUTPUT_DIR=./uploads/pdf

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Backup Configuration
BACKUP_DIR=./backups
BACKUP_SCHEDULE=0 2 * * *

# SSL Configuration (for production)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Admin Default User (will be created on first run)
ADMIN_EMAIL=admin@gestionale.com
ADMIN_PASSWORD=change_this_password_immediately
ADMIN_NAME=Amministratore
ADMIN_SURNAME=Sistema