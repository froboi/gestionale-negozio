# Docker Environment Configuration

# Database
DB_ROOT_PASSWORD=securepassword
DB_NAME=gestionale_abbigliamento
DB_USER=gestionale_user
DB_PASSWORD=userpassword

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token

# 2FA OTP delivery (use log locally, smtp in production)
NODE_ENV=development
OTP_DELIVERY_MODE=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_google_app_password
SMTP_FROM="Gestionale Negozio <your_email@gmail.com>"

# SSL Configuration (for production)
SSL_CERT_PATH=./ssl/cert.pem
SSL_KEY_PATH=./ssl/private.key
